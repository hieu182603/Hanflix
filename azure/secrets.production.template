# HanFlix Production Secrets — DO NOT COMMIT
# Use this file to populate Key Vault. Delete after use.

# === REQUIRED ===
MONGODB_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SEED_ADMIN_PASSWORD=

# === R2 (Cloudflare) — REQUIRED in production ===
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
# R2_ENDPOINT auto-derived from R2_ACCOUNT_ID, override only if custom domain

# === Email (SMTP) — REQUIRED in production ===
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# === Metrics — REQUIRED in production ===
METRICS_TOKEN=

# === Redis — REQUIRED in production (for shared rate limiting) ===
REDIS_URL=

# === Azure AI — REQUIRED if VIDEO_WORKER_MODE != disabled ===
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# === Google AI (Gemini) ===
GEMINI_API_KEY=

# === Google OAuth (optional) ===
GOOGLE_CLIENT_ID=
