 'PLACEHOLDER_SET_AFTER_DEPLOY'), createObject('name', 'metrics-token', 'value', 'PLACEHOLDER_SET_AFTER_DEPLOY'))))]"
                },
                "template": {
                  "containers": [
                    {
                      "name": "hanflix-backend",
                      "image": "[variables('actualImage')]",
                      "resources": {
                        "cpu": "[json(format('\"{0}\"', parameters('cpuCoreCount')))]",
                        "memory": "[format('{0}Gi', parameters('memoryGb'))]"
                      },
                      "env": [
                        {
                          "name": "NODE_ENV",
                          "value": "[parameters('nodeEnv')]"
                        },
                        {
                          "name": "PORT",
                          "value": "4000"
                        },
                        {
                          "name": "APP_PUBLIC_URL",
                          "value": "[parameters('appPublicUrl')]"
                        },
                        {
                          "name": "MONGODB_URI",
                          "secretRef": "mongodb-uri"
                        },
                        {
                          "name": "MONGODB_TLS",
                          "value": "true"
                        },
                        {
                          "name": "JWT_ACCESS_SECRET",
                          "secretRef": "jwt-access-secret"
                        },
                        {
                          "name": "JWT_REFRESH_SECRET",
                          "secretRef": "jwt-refresh-secret"
                        },
                        {
                          "name": "SEED_ADMIN_PASSWORD",
                          "secretRef": "seed-admin-password"
                        },
                        {
                          "name": "SMTP_HOST",
                          "secretRef": "smtp-host"
                        },
                        {
                          "name": "SMTP_PORT",
                          "secretRef": "smtp-port"
                        },
                        {
                          "name": "SMTP_SECURE",
                          "secretRef": "smtp-secure"
                        },
                        {
                          "name": "SMTP_USER",
                          "secretRef": "smtp-user"
                        },
                        {
                          "name": "SMTP_PASS",
                          "secretRef": "smtp-pass"
                        },
                        {
                          "name": "SMTP_FROM",
                          "secretRef": "smtp-from"
                        },
                        {
                          "name": "R2_ACCOUNT_ID",
                          "secretRef": "r2-account-id"
                        },
                        {
                          "name": "R2_ACCESS_KEY_ID",
                          "secretRef": "r2-access-key-id"
                        },
                        {
                          "name": "R2_SECRET_ACCESS_KEY",
                          "secretRef": "r2-secret-access-key"
                        },
                        {
                          "name": "R2_BUCKET_NAME",
                          "secretRef": "r2-bucket-name"
                        },
                        {
                          "name": "R2_PUBLIC_BASE_URL",
                          "secretRef": "r2-public-base-url"
                        },
                        {
                          "name": "GEMINI_API_KEY",
                          "secretRef": "gemini-api-key"
                        },
                        {
                          "name": "AZURE_TRANSLATOR_KEY",
                          "secretRef": "azure-translator-key"
                        },
                        {
                          "name": "AZURE_SPEECH_KEY",
                          "secretRef": "azure-speech-key"
                        },
                        {
                          "name": "GOOGLE_CLIENT_ID",
                          "secretRef": "google-client-id"
                        },
                        {
                          "name": "METRICS_TOKEN",
                          "secretRef": "metrics-token"
                        },
                        {
                          "name": "GEMINI_MODEL",
                          "value": "gemini-3.5-flash-lite"
                        },
                        {
                          "name": "GEMINI_TIMEOUT_MS",
                          "value": "15000"
                        },
                        {
                          "name": "GEMINI_TRANSLATION_IMPROVE_ENABLED",
                          "value": "true"
                        },
                        {
                          "name": "AZURE_TRANSLATOR_REGION",
                          "value": "[parameters('azureTranslatorRegion')]"
                        },
                        {
                          "name": "AZURE_SPEECH_REGION",
                          "value": "[parameters('azureSpeechRegion')]"
                        },
                        {
                          "name": "PLAYBACK_DERIVATIVE_ENABLED",
                          "value": "true"
                        },
                        {
                          "name": "PLAYBACK_DERIVATIVE_MAX_HEIGHT",
                          "value": "720"
                        },
                        {
                          "name": "VIDEO_WORKER_MODE",
                          "value": "embedded"
                        },
                        {
                          "name": "VIDEO_PROCESSING_MAX_RETRIES",
                          "value": "3"
                        },
                        {
                          "name": "APP_ORIGINS",
                          "value": "[parameters('allowedOrigins')]"
                        },
                        {
                          "name": "COOKIE_SECURE",
                          "value": "[if(equals(parameters('nodeEnv'), 'production'), 'true', 'false')]"
                        },
                        {
                          "name": "DISABLE_TRANSACTIONS",
                          "value": "true"
                        }
                      ],
                      "probes": [
                        {
                          "type": "Liveness",
                          "httpGet": {
                            "path": "[parameters('healthCheckPath')]",
                            "port": 4000,
                            "scheme": "HTTPS"
                          },
                          "initialDelaySeconds": 15,
                          "periodSeconds": 30,
                          "timeoutSeconds": 5,
                          "failureThreshold": 3
                        },
                        {
                          "type": "Readiness",
                          "httpGet": {
                            "path": "[parameters('healthCheckPath')]",
                            "port": 4000,
                            "scheme": "HTTPS"
                          },
                          "initialDelaySeconds": 10,
                          "periodSeconds": 10,
                          "timeoutSeconds": 3,
                          "failureThreshold": 3
                        }
                      ]
                    }
                  ],
                  "scale": {
                    "minReplicas": "[parameters('minReplicas')]",
                    "maxReplicas": "[parameters('maxReplicas')]",
                    "rules": [
                      {
                        "name": "http-scaling",
                        "http": {
                          "metadata": {
                            "concurrentRequests": "100"
                          }
                        }
                      },
                      {
                        "name": "cpu-scaling",
                        "custom": {
                          "type": "cpu",
                          "metadata": {
                            "type": "Utilization",
                            "value": "70"
                          }
                        }
                      },
                      {
                        "name": "memory-scaling",
                        "custom": {
                          "type": "memory",
                          "metadata": {
                            "type": "Utilization",
                            "value": "80"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "outputs": {
            "fqdn": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '2023-05-01').configuration.ingress.fqdn]"
            },
            "backendUrl": {
              "type": "string",
              "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '2023-05-01').configuration.ingress.fqdn)]"
            },
            "containerAppId": {
              "type": "string",
              "value": "[resourceId('Microsoft.App/containerApps', parameters('containerAppName'))]"
            },
            "containerAppName": {
              "type": "string",
              "value": "[parameters('containerAppName')]"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deployments', 'container-app-env-deployment')]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('managedIdName'))]"
      ]
    }
  ],
  "outputs": {
    "backendUrl": {
      "type": "string",
      "value": "[format('https://{0}', variables('backendFqdn'))]"
    },
    "backendFqdn": {
      "type": "string",
      "value": "[variables('backendFqdn')]"
    },
    "keyVaultName": {
      "type": "string",
      "value": "[variables('kvName')]"
    },
    "keyVaultUri": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'kv-deployment'), '2025-04-01').outputs.keyVaultUri.value]"
    },
    "containerAppEnvId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'container-app-env-deployment'), '2025-04-01').outputs.containerAppEnvId.value]"
    },
    "resourceGroup": {
      "type": "string",
      "value": "[resourceGroup().name]"
    }
  }
}