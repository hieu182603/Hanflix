NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_PUBLIC_URL=http://localhost:5173
APP_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/hanflix?retryWrites=true&w=majority
MONGODB_DB_NAME=Hanflix
# SECURITY (H-5): Force TLS for MongoDB. Required in production. Set to false only for local mongod.
MONGODB_TLS=true
# Optional: Allow self-signed certificates (local dev only). Must be false in production.
MONGODB_TLS_ALLOW_INVALID=false

# Auth & Security
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
REFRESH_COOKIE_NAME=hanflix_refresh
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Google OAuth
GOOGLE_CLIENT_ID=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HanFlix <no-reply@example.com>
SMTP_TIMEOUT_MS=10000
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30

# Cloudflare R2 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hanflix-media
# Optional. When blank, backend derives https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
R2_UPLOAD_URL_TTL_SECONDS=900
R2_DOWNLOAD_URL_TTL_SECONDS=3600
MAX_VIDEO_BYTES=104857600

# Google Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=15000

# Azure Translator
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=southeastasia
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Azure Speech to Text
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
# Optional. When blank, backend derives https://<AZURE_SPEECH_REGION>.api.cognitive.microsoft.com
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_LOCALE=zh-CN
AZURE_SPEECH_API_VERSION=2025-10-15
AZURE_PROVIDER_MAX_RETRIES=2

# Video Processing Worker
VIDEO_WORKER_MODE=embedded
VIDEO_PROCESSING_MAX_RETRIES=3
VIDEO_PROCESSING_TIMEOUT_MINUTES=30
VIDEO_PROCESSING_POLL_MS=5000

# ==============================================================================
# Video Playback Optimization (FastStart & Web Transcoding)
# Tối ưu phát video trên trình duyệt: chuyển mã MP4 sang chuẩn web có cờ `+faststart`
# giúp người xem tua/xem video ngay lập tức mà không cần đợi tải toàn bộ file.
# ==============================================================================
# Bật/tắt tối ưu video (true: tạo bản MP4 web tối ưu; false: giữ nguyên file gốc)
PLAYBACK_DERIVATIVE_ENABLED=true
# Chiều cao tối đa của video phái sinh (downscale về mức này nếu video gốc lớn hơn, không upscale)
PLAYBACK_DERIVATIVE_MAX_HEIGHT=720
# Bitrate mục tiêu H.264 (kbps). Mặc định 2500 kbps cho 720p. Đặt 0 để ffmpeg tự tính toán theo CRF
PLAYBACK_DERIVATIVE_VIDEO_BITRATE_KBPS=2500

# ==============================================================================
# MongoDB Transactions Fallback
# ==============================================================================
# MongoDB Atlas gói miễn phí (M0 Free tier) hoặc cụm standalone có thể không hỗ trợ Multi-Document Transactions ổn định.
# - true: Kích hoạt ghi tuần tự an toàn (sequential writes fallback), khuyến nghị cho Atlas M0 / local không có Replica Set.
# - false: Sử dụng transaction chuẩn của MongoDB, dùng cho môi trường production có cụm Replica Set chuyên dụng.
DISABLE_TRANSACTIONS=false

# ==============================================================================
# Rate Limiting (Giới hạn tần suất gọi API)
# ==============================================================================
# Khung thời gian tính giới hạn (mili-giây), mặc định 60000ms = 1 phút
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
# Giới hạn API chung: tối đa số request / phút cho mỗi tài khoản (hoặc mỗi IP nếu chưa đăng nhập)
GLOBAL_RATE_LIMIT_MAX=600
# Giới hạn đăng nhập sai: tối đa số lần thử thất bại / IP trong 15 phút (đăng nhập thành công không tính)
AUTH_RATE_LIMIT_MAX=10
# Giới hạn làm mới token (Session refresh): tối đa số request / IP trong 1 phút
REFRESH_RATE_LIMIT_MAX=60
# Giới hạn tính năng AI (Gemini): tối đa số request / tài khoản trong 1 phút
AI_RATE_LIMIT_MAX=24
# Giới hạn tải file lên (Upload video/media): tối đa số request / tài khoản trong 1 phút
UPLOAD_RATE_LIMIT_MAX=60
# Giới hạn broadcast notification (Admin): tối đa số broadcast / tài khoản trong 10 phút.
# Ngăn admin compromised hoặc script lỗi spam bảng notifications.
BROADCAST_RATE_LIMIT_MAX=30
# SECURITY (H-1 / C-3): REQUIRED IN PRODUCTION for shared rate limiting across replicas.
# When unset, each container has its own counter (limit becomes limit * replica count).
# Azure Cache for Redis: redis://default:YOUR_PASSWORD@hanflix.redis.cache.windows.net:6380
# Upstash Redis: redis://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379
REDIS_URL=

# Operations (required in production; send as Authorization: Bearer <token>)
METRICS_TOKEN=
# SECURITY (SEC-04): Optional comma-separated list of CIDR ranges / IPs that may scrape /metrics.
# Example: 10.0.0.0/8,127.0.0.1
METRICS_IP_ALLOWLIST=

# Seed Admin
SEED_ADMIN_EMAIL=admin@hanflix.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional direct Cloudinary URL (e.g. cloudinary://API_KEY:API_SECRET@CLOUD_NAME)
CLOUDINARY_URL=
