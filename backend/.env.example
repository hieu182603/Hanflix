NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_ORIGINS=http://localhost:5173,http://localhost:3000

# MongoDB Atlas: create a database user, allow the API host IP, then paste the SRV URI.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/hanflix?retryWrites=true&w=majority
MONGODB_DB_NAME=hanflix

# Use independent random secrets of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
REFRESH_COOKIE_NAME=hanflix_refresh
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Cloudflare R2 S3-compatible credentials. Never expose these to the browser.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hanflix-media
R2_PUBLIC_BASE_URL=
R2_UPLOAD_URL_TTL_SECONDS=900
R2_DOWNLOAD_URL_TTL_SECONDS=3600
MAX_VIDEO_BYTES=104857600

# Google Gemini. Model is configurable so deployment is not tied to one preview model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=15000

GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_MAX=12
UPLOAD_RATE_LIMIT_MAX=20

# Development seed only. Change or remove after first seed.
SEED_ADMIN_EMAIL=admin@hanflix.local
SEED_ADMIN_PASSWORD=ChangeMe123!
