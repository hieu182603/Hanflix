{
  "name": "hanflix-backend",
  "version": "0.1.0",
  "private": true,
  "description": "HanFlix MVP API",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nodemon",
    "dev:tsx": "tsx watch src/server.ts",
    "worker": "node dist/workers/video-processing.worker.js",
    "worker:dev": "tsx src/workers/video-processing.worker.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "email:verify": "tsx src/scripts/verify-email.ts",
    "r2:cors:verify": "tsx src/scripts/verify-r2-cors.ts",
    "db:indexes": "tsx src/scripts/create-indexes.ts",
    "seed": "tsx src/scripts/seed.ts",
    "vocab:download": "tsx scripts/vocabulary/download-hsk-data.ts",
    "vocab:normalize": "tsx scripts/vocabulary/normalize-hsk-data.ts",
    "vocab:validate": "tsx scripts/vocabulary/validate-vocabulary.ts",
    "vocab:seed": "tsx scripts/vocabulary/seed-vocabulary.ts",
    "seed:users": "tsx scripts/seed-realistic-users.ts",
    "cleanup:processing-artifacts": "tsx scripts/cleanup-processing-artifacts.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@azure-rest/ai-translation-text": "^2.0.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@google/genai": "^2.24.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pinyin-pro": "^3.29.4",
    "prom-client": "^15.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.3",
    "@types/supertest": "^7.2.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
